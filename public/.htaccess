# ── Front controller (سازگار با Apache 2.2/2.4 و هاست‌های اشتراکی) ──
<IfModule mod_rewrite.c>
    RewriteEngine On

    # انتقال هدر Authorization به PHP (CGI/FastCGI)
    RewriteCond %{HTTP:Authorization} ^(.+)$
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]

    # فقط «فایل‌های واقعی» (css/js/تصویر) مستقیم سرو می‌شوند؛ بقیه (حتی /) → index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L,QSA]
</IfModule>

# فایل‌های مخفی (.env, .git, ...)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
