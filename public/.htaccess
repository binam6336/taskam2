# ── Front controller (سازگار با Apache 2.2/2.4 و هاست‌های اشتراکی) ──
<IfModule mod_rewrite.c>
    RewriteEngine On

    # انتقال هدر Authorization به PHP (CGI/FastCGI)
    RewriteCond %{HTTP:Authorization} ^(.+)$
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]

    # فقط «فایل‌های واقعی» (css/js/تصویر) مستقیم سرو می‌شوند؛ بقیه (حتی /) → index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L,QSA]
</IfModule>

# فایل‌های مخفی (.env, .git, ...)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# v7.3: تا ۳۰ فایل در یک ارسال (پیوست تسک/یادداشت)؛ پیش‌فرض PHP بیست است. روی PHP-FPM همین در public/.user.ini آمده.
<IfModule mod_php.c>
    php_value max_file_uploads 30
</IfModule>
<IfModule mod_php7.c>
    php_value max_file_uploads 30
</IfModule>

# v7.3 سرعت: فایل‌های ثابت (css/js/فونت/تصویر) نسخه‌دار هستند (?v=زمان تغییر) ← کش طولانی در مرورگر؛ فشرده‌سازی متن‌ها
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|woff2|woff|ttf|svg|png|jpg|jpeg|webp|gif|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/plain
</IfModule>
