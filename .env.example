# ── Application ────────────────────────────────────────────
APP_NAME="کارلیکس"
APP_ENV=production          # production | local
APP_DEBUG=false             # در محیط واقعی حتماً false
LOG_RETENTION_DAYS=30       # روزهای نگه‌داری لاگ‌ها در storage/logs (لاگ عمومی و پوشه‌ی هر بخش)؛ 0 = بدون حذف خودکار
APP_URL=                    # خالی = تشخیص خودکار. مثال: https://example.com/tapin/task
APP_TIMEZONE=Asia/Tehran
APP_KEY=                    # php -r "echo bin2hex(random_bytes(32));"

# ── Database ───────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=taskam
DB_USER=taskam
DB_PASS=
DB_TIMEZONE=+03:30

# ── Security ───────────────────────────────────────────────
SESSION_REMEMBER_DAYS=30     # مدت نشست با «مرا به خاطر بسپار»
SESSION_IDLE_MINUTES=60     # مدت عدم فعالیت مجاز بدون «مرا به خاطر بسپار»
SESSION_DRIVER=db           # db = جدول user_sessions (فقط هش شناسه)؛ file = فایل در storage/cache/sessions
SESSION_IP_BIND=prefix      # اتصال نشست به شبکه‌ی ورود: prefix = دو بخش اول IP، full = IP کامل، off = خاموش
LOGIN_MAX_ATTEMPTS=5        # تلاش ناموفق مجاز در پنجره‌ی زمانی
LOGIN_WINDOW_MINUTES=15
TRUSTED_PROXY=false         # پشت Cloudflare: cloudflare — پشت Nginx/پراکسی روی همان سرور: true — هدر IP فقط از پراکسی مورد اعتماد پذیرفته می‌شود
TRUSTED_PROXY_IPS=          # با TRUSTED_PROXY=true و پراکسی روی سرور دیگر: IP یا CIDR پراکسی‌ها با کاما (خالی = فقط loopback همین سرور؛ پراکسی در Docker/شبکه‌ی خصوصی را صریح بنویسید، مثل 172.18.0.0/16)
CAPTCHA_LOGIN=true          # کپچای تصویری صفحه‌ی ورود؛ false فقط برای محیط توسعه/تست خودکار
IMPERSONATE_IDLE_MINUTES=30   # ورود مدیر به پنل کاربر (تب جداگانه): بسته شدن پنجره بعد از این مدت بی‌فعالیتی (۵ تا ۲۴۰)
IMPERSONATE_MAX_HOURS=4       # سقف عمر هر پنجره‌ی ورود به پنل کاربر (۱ تا ۱۲ ساعت)
API_ALLOW_QUERY_TOKEN=false # ?token=... (منسوخ و ناامن)
API_CORS_ORIGIN=            # دامنه‌هایی که از مرورگر به API درخواست می‌دهند (با کاما): https://app.example.com — خالی = هیچ؛ * = همه (توصیه نمی‌شود)
API_RATE_LIMIT=120           # سقف درخواست API هر کاربر در دقیقه (۰ = بدون سقف)

# ── رمزگذاری پیام‌های چت (AES-256-GCM) ───────────────────────
# متن پیام‌ها و نام فایل‌ها در دیتابیس به‌صورت enc:v1:… ذخیره می‌شود و فقط با همین رمز خوانده می‌شود.
# حداقل ۱۲ نویسه؛ پیشنهاد: رشته‌ی تصادفی ۶۴ نویسه →  php -r "echo bin2hex(random_bytes(32));"
# ⚠️ این رمز را گم نکنید (بدون آن پیام‌ها قابل بازیابی نیست) و بعد از استفاده مستقیم تغییر ندهید؛
#    تغییر کلید قدیمی چت: OLD_ENCODE_PASSWORD='قدیمی' php bin/chat-crypto.php rotate
# کلید محتوای دیتابیس، حداقل ۱۲ نویسه؛ اگر خالی باشد همان ENCODE_PASSWORD فعلی استفاده می‌شود.
# مقدار ENCODE_PASSWORD را تغییر یا حذف نکنید؛ تغییر نام متغیر جایگزین مهاجرت کلید نیست.
decode_key=
ENCODE_PASSWORD=
ENCODE_KDF_ITER=20000       # هزینه‌ی مشتق‌سازی کلید (در هر پیام ذخیره می‌شود)
ENCODE_KDF_ITER_OLD=        # اگر ENCODE_KDF_ITER را عوض کردید، مقدار(های) قبلی را با کاما این‌جا بنویسید تا پیام‌های قدیمی خوانده شوند (فقط همین مقادیر پذیرفته می‌شود)

# ── اعلان‌های PWA (Web Push / VAPID) — اختیاری ───────────────
# اگر خالی بماند، کلیدها در اولین استفاده ساخته و در storage/vapid.json ذخیره می‌شوند (از آن فایل نسخه‌ی پشتیبان بگیرید).
VAPID_SUBJECT=               # مثال: mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# مهاجرت خودکار دیتابیس در درخواست‌های وب (نیاز به دسترسی ALTER/CREATE). false = فقط با php bin/migrate.php
SCHEMA_AUTO=true            # در محیط واقعی توصیه: false + یک کاربر دیتابیس بدون مجوز ALTER/CREATE برای برنامه، و بعد از هر به‌روزرسانی php bin/migrate.php (با کاربر دارای مجوز)

# سهمیه‌ی آپلود هر کاربر در ۲۴ ساعت (مگابایت، همه‌ی بخش‌ها) و حداکثر حجم هر فایل چت
UPLOAD_DAILY_MB=500
CHAT_FILE_MAX_MB=20
PUSH_PREVIEW=true           # متن پیام چت در اعلان (Push) نمایش داده شود؟ false = فقط «پیام جدید از …» بدون متن
VIRUS_SCAN=                 # اسکن پیوست‌ها با ClamAV: clamdscan یا clamscan (خالی = بدون اسکن)

# صندوق بررسی سرپرست: مهلت بررسی تحویل‌ها (ساعت)
REVIEW_SLA_HOURS=24

# ───── دستیار هوش مصنوعی «کارلیکس» (v7.19) — منشن @کارلیکس در یادداشت تسک ─────
# کلید فقط این‌جا (بک‌اند) نگه‌داری می‌شود و هرگز در صفحه، پاسخ شبکه یا لاگ نمی‌آید. خالی = کارلیکس غیرفعال (در فهرست منشن با توضیح نمایش داده می‌شود).
AI_ENABLED=true
AGNES_API_KEY=
AGNES_API_URL=https://apihub.agnes-ai.com/v1/chat/completions
AGNES_MODEL=agnes-2.5-flash
AI_TIMEOUT=30               # ثانیه برای هر درخواست به سرویس (۵ تا ۶۰)
AI_MAX_CONCURRENT=8         # (v7.24) حداکثر فراخوانی هم‌زمان مدل در کل سرور (همه‌ی کاربران)؛ بقیه در صف می‌مانند. ۰ = بدون محدودیت
AI_QUEUE_SECONDS=20         # (v7.24) حداکثر انتظار هر فراخوانی در صف؛ بعد از آن خطای موقت busy (و تلاش مجدد خودکار)
AI_MAX_WAITING=16           # (v7.26) حداکثر فراخوانی منتظر در صف (بیشتر = فوراً busy تا worker های PHP پشت صف پر نشوند). ۰ = بدون سقف
AI_WORKER=true              # (v7.26) استفاده از اجراکننده‌ی سمت سرور bin/ai-worker.php (cron هر دقیقه) وقتی در حال اجراست؛ false = همیشه از مرورگر
AI_WORKER_PROCS=2           # (v7.26) تعداد فرایند موازی ai-worker (گزینه‌ی --procs هم همین را تعیین می‌کند)
AI_REQUEST_EXPIRE_MINUTES=15  # (v7.26) درخواست کارلیکس قدیمی‌تر از این در صف اجرا نمی‌شود و «منقضی شد» می‌گیرد
AI_JSON_MODE=false          # true = ارسال response_format=json_object (فقط اگر مدل پشتیبانی کند)
AI_PER_MINUTE=6             # سقف درخواست از کارلیکس برای هر کاربر در دقیقه
AI_DAILY_LIMIT=100          # سقف درخواست از کارلیکس برای هر کاربر در ۲۴ ساعت (مشترک با دستیار بورد)
AI_RESERVE_BYTES_PER_TOKEN=3  # (v7.22: پیش‌فرض ۳؛ مصرف واقعی متن فارسی+JSON حدود ۳٫۴ بایت در هر توکن است) رزرو سهمیه پیش از هر فراخوانی = بایت ورودی ÷ این عدد + max_tokens (کمتر = رزرو محتاطانه‌تر)
AI_USAGE_MISSING=reserved     # پاسخ بدون usage: reserved = همان رزرو حساب شود | zero = صفر
AI_PRICE_INPUT_PER_1M=0       # (اختیاری) نرخ هر یک میلیون توکن ورودی برای ثبت هزینه در ai_usage.cost
AI_PRICE_OUTPUT_PER_1M=0      # (اختیاری) نرخ هر یک میلیون توکن خروجی
AI_PRICE_CURRENCY=USD
AI_EXPORT_MINUTES=30        # اعتبار لینک دانلود خروجی CSV/PDF دستیار بورد (دقیقه)

# بک‌اند کاربر Laravel است؛ برای بازگشت موقت legacy بگذارید. laravel نیازمند PHP 8.2+ و نصب وابستگی‌هاست.
USER_ROUTER=laravel

# جلسه‌های آنلاین؛ کلیدها فقط روی بک‌اند. نشانی دقیق پروژهٔ Cloud، بدون مسیر اضافه
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_MAX_PARTICIPANTS=30
