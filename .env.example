# ── Application ────────────────────────────────────────────
APP_NAME="تسکام"
APP_ENV=production          # production | local
APP_DEBUG=false             # در محیط واقعی حتماً false
APP_URL=                    # خالی = تشخیص خودکار. مثال: https://example.com/tapin/task
APP_TIMEZONE=Asia/Tehran
APP_KEY=                    # php -r "echo bin2hex(random_bytes(32));"

# ── Database ───────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=taskam
DB_USER=taskam
DB_PASS=
DB_TIMEZONE=+03:30

# ── Security ───────────────────────────────────────────────
SESSION_REMEMBER_DAYS=30     # مدت نشست با «مرا به خاطر بسپار»
SESSION_IDLE_MINUTES=60     # مدت عدم فعالیت مجاز بدون «مرا به خاطر بسپار»
LOGIN_MAX_ATTEMPTS=5        # تلاش ناموفق مجاز در پنجره‌ی زمانی
LOGIN_WINDOW_MINUTES=15
TRUSTED_PROXY=false         # فقط پشت Cloudflare/Nginx روی true
API_ALLOW_QUERY_TOKEN=false # ?token=... (منسوخ و ناامن)
API_CORS_ORIGIN=*           # برای محدودسازی: https://app.example.com

# ── رمزگذاری پیام‌های چت (AES-256-GCM) ───────────────────────
# متن پیام‌ها و نام فایل‌ها در دیتابیس به‌صورت enc:v1:… ذخیره می‌شود و فقط با همین رمز خوانده می‌شود.
# حداقل ۱۲ نویسه؛ پیشنهاد: رشته‌ی تصادفی ۶۴ نویسه →  php -r "echo bin2hex(random_bytes(32));"
# ⚠️ این رمز را گم نکنید (بدون آن پیام‌ها قابل بازیابی نیست) و بعد از استفاده مستقیم تغییر ندهید؛
#    برای تغییر: OLD_ENCODE_PASSWORD='قدیمی' php bin/chat-crypto.php rotate
ENCODE_PASSWORD=
ENCODE_KDF_ITER=20000       # هزینه‌ی مشتق‌سازی کلید (در هر پیام ذخیره می‌شود؛ تغییرش مشکلی ایجاد نمی‌کند)
